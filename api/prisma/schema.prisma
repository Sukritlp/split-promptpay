// โครงสร้างฐานข้อมูล — แก้ไฟล์นี้แล้วรัน `npm run db:migrate` เพื่อสร้าง migration ใหม่

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  // tsconfig ใช้ NodeNext → import ภายในต้องลงท้าย .js
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  // null ได้: ผู้ใช้ที่สมัครผ่าน Google OAuth จะไม่มีรหัสผ่าน
  passwordHash String?  @map("password_hash")
  // เบอร์โทรหรือเลขบัตรประชาชน — เก็บเป็น string เพื่อไม่ให้เลข 0 นำหน้าหาย
  promptpayId  String?  @map("promptpay_id")
  lineUserId   String?  @unique @map("line_user_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens RefreshToken[]
  ownedGroups   Group[]        @relation("GroupOwner")
  memberships   GroupMember[]

  @@map("users")
}

/// refresh token แบบ opaque (สตริงสุ่ม) — เก็บแค่ hash ไม่เก็บตัวจริง
/// token ที่ต่อกันมาจากการล็อกอินครั้งเดียวกันมี familyId เดียวกัน (ใช้ตรวจจับการใช้ token ซ้ำ)
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  // SHA-256 ของ token (base64url) — DB หลุดก็เอาไปใช้แทน token ไม่ได้
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  // null = ยังใช้ได้
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

enum GroupRole {
  owner
  member

  @@map("group_role")
}

/// กลุ่มหารบิล — ลิงก์เชิญใช้ inviteCode (กลุ่มละ 1 code, owner reset ได้)
model Group {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  // RESTRICT: ลบ user ที่เป็นเจ้าของกลุ่มไม่ได้ (กันประวัติค่าใช้จ่ายของทั้งกลุ่มหาย)
  ownerId    String   @map("owner_id") @db.Uuid
  // PromptPay รองรับแค่บาท — API รับแค่ THB ตอนนี้ แต่มีคอลัมน์ไว้รองรับอนาคต
  currency   String   @default("THB")
  // สุ่ม 128 bit (base64url) — ใครได้ลิงก์ก็เข้าร่วมได้ จึงต้องเดาไม่ได้
  inviteCode String   @unique @map("invite_code")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner   User          @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members GroupMember[]

  @@index([ownerId])
  @@map("groups")
}

/// สมาชิกของกลุ่ม — PK คู่ (group_id, user_id): DB กันไม่ให้เป็นสมาชิกซ้ำ
model GroupMember {
  groupId  String    @map("group_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  role     GroupRole @default(member)
  joinedAt DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // RESTRICT: ลบ user ที่ยังเป็นสมาชิกกลุ่มไม่ได้ (ประวัติค่าใช้จ่ายอ้างถึงคนนี้)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([groupId, userId])
  // "กลุ่มของฉัน" ค้นด้วย user_id — PK เริ่มด้วย group_id จึงใช้ค้นแบบนี้ไม่ได้ ต้องมี index แยก
  @@index([userId])
  @@map("group_members")
}
