# คัดลอกเป็น .env แล้วแก้ค่าตามเครื่องตัวเอง
NODE_ENV=development
PORT=3000

# ค่าต้องตรงกับ docker-compose.yml
DATABASE_URL=postgresql://splitpay:splitpay@localhost:5432/splitpay?schema=public

# สร้าง secret ใหม่ด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# อย่างน้อย 32 ตัวอักษร และต้องไม่ใช้ค่าเดียวกับ production
JWT_ACCESS_SECRET=change-me-to-a-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
